# SERVER ONLY: reference for Supabase Edge Function secrets. Never bundle in an app.
# Enter real values directly in Supabase Project Settings > Edge Functions > Secrets.
# Empty placeholders intentionally keep senders disabled.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_PUBLIC_BASE_URL=https://www.opportunity313.com
# Entire service account JSON, serialized on one line; never a client config file.
FIREBASE_SERVICE_ACCOUNT_JSON=
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by hosted Edge Functions.
# Dispatch credentials already live in Vault. Do not replace them with client keys.
